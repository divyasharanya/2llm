# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.

# Gemini API key (Google AI Studio)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (for LLaMA models via Groq)
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth / Auth.js secret (generate with: openssl rand -hex 32)
AUTH_SECRET=your_auth_secret_here

# Deployed app URL (use http://localhost:3000 for local dev)
AUTH_URL=https://your-amplify-app-url.amplifyapp.com

# AWS credentials for DynamoDB
APP_AWS_REGION=ap-south-1
APP_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
APP_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# DynamoDB table names
DYNAMODB_TABLE_NAME=UserChats

# Admin email address (grants access to /admin panel)
ADMIN_EMAIL=your_admin_email@example.com
